{
  order pmtiles_proxy before reverse_proxy
}

# Caddy configuration for the Syrtis-Jezero app
:80

log {
  # Log to stdout
  output stdout
  # Log all requests
  format console
}

# Open CORS config
header {
  # Allow CORS for all origins
  ?Access-Control-Allow-Origin *
  ?Access-Control-Allow-Methods GET, OPTIONS
  ?Access-Control-Allow-Headers *
}

# Raster tiles
handle_path /tiles/* {
  # Caddy extension for serving PMTiles
  # archives
  pmtiles_proxy {
    bucket {$TILESET_BASE_URL}
    cache_size 256
    public_url {$PUBLIC_URL:""}/tiles
  }
}

handle_path /openplanetary-tiles/* {
  # Proxy OpenPlanetary's MOLA-Grey tiles so we can cache
  # them and also add CORS headers
  # Log the upstream request
  reverse_proxy {
    to http://whereonmars.cartodb.net.s3.amazonaws.com
    header_up Host {upstream_hostport}
  }
}

handle_path /vector-tiles/* {
  reverse_proxy vector_tiles:7800
}

# API
handle_path /api/pg/* {
  reverse_proxy postgrest:3000
}

# Send a description for the root page
handle_path / {
    respond "This is the API for the Syrtis-Jezero application"
}
